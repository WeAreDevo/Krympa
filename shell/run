#!/bin/bash

BENCHMARK_DIR="../benchmarks"
PYTHON_SCRIPT="../python/generate_input.py"
RUST_DIR="../rust"
BENCHMARK_BINARY="./benchmarking_binary"

# default krympa binary
KRYMPA_BINARY_DEFAULT="./krympa"

# defaults
TIMEOUT_SECS=2700
KRYMPA_BINARY="$KRYMPA_BINARY_DEFAULT"
EXECUTION_MODE_FLAG="${KRYMPA_EXECUTION_MODE:---parallel}"

# argument parsing
if [ $# -ge 1 ]; then
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        TIMEOUT_SECS="$1"
        KRYMPA_BINARY="${2:-$KRYMPA_BINARY_DEFAULT}"
    else
        KRYMPA_BINARY="$1"
        TIMEOUT_SECS="${2:-2700}"
    fi
fi

if [ $# -gt 2 ]; then
    echo "Usage: $0 [timeout_secs] [krympa_binary]"
    echo "   or: $0 [krympa_binary]"
    exit 1
fi

mkdir -p "$BENCHMARK_DIR/output_logs"
# clean existing logs
rm -f "$BENCHMARK_DIR/output_logs"/*
ORIG_DIR=$(pwd)

echo "======================================"
echo "Krympa benchmark run starting"
echo "Timeout per benchmark : ${TIMEOUT_SECS}s"
echo "Krympa binary         : ${KRYMPA_BINARY}"
echo "Execution mode        : ${EXECUTION_MODE_FLAG#--}"
echo "Logs directory        : ${BENCHMARK_DIR}/output_logs"
echo "======================================"
echo

run_one() {
    proofs_file="$1"
    base=$(basename "$proofs_file" .lean)

    echo "Processing $base ..."

    # Generate input using python script
    python3 "$PYTHON_SCRIPT" "$proofs_file"

    input_folder="$BENCHMARK_DIR/input${base//Proofs/}"
    if [ ! -d "$input_folder" ]; then
        echo "Input folder $input_folder not found! Skipping $base."
        return
    fi

    log_file="$BENCHMARK_DIR/output_logs/${base}.log"
    echo "Running benchmarking for $base (timeout=${TIMEOUT_SECS}s)..."

    cd "$RUST_DIR" || exit 1
    "$BENCHMARK_BINARY" "$input_folder" "$TIMEOUT_SECS" "$KRYMPA_BINARY" "$EXECUTION_MODE_FLAG" > "$log_file" 2>&1
    cd "$ORIG_DIR" || exit 1

    echo "Finished benchmarking for $base"
    echo "Log written to $log_file"
    echo
}

for proofs_file in "$BENCHMARK_DIR"/Proofs*.lean; do
    run_one "$proofs_file"
done

echo "All jobs completed."
echo "Detailed logs are available in: ${BENCHMARK_DIR}/output_logs"
