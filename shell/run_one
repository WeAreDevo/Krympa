#!/usr/bin/env bash
set -e

MODE_FLAG="${KRYMPA_EXECUTION_MODE:---parallel}"
if [ $# -ge 1 ]; then
  case "$1" in
    --parallel|--sequential)
      MODE_FLAG="$1"
      shift
      ;;
    --execution-mode)
      if [ $# -lt 2 ]; then
        echo "Usage: $0 [--parallel|--sequential] <input-file> [krympa-binary]"
        exit 1
      fi
      MODE_FLAG="--$2"
      shift 2
      ;;
    --execution-mode=parallel)
      MODE_FLAG="--parallel"
      shift
      ;;
    --execution-mode=sequential)
      MODE_FLAG="--sequential"
      shift
      ;;
  esac
fi

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "Usage: $0 [--parallel|--sequential] <input-file> [krympa-binary]"
  exit 1
fi

INPUT="$1"
KRYMPA_BINARY="${2:-./krympa}"

cd ../rust || {
  echo "Error: could not cd into ../rust"
  exit 1
}

if [ ! -x "$KRYMPA_BINARY" ]; then
  echo "Error: binary '$KRYMPA_BINARY' not found or not executable."
  exit 1
fi

"$KRYMPA_BINARY" "$MODE_FLAG" run_vampire "$INPUT"
"$KRYMPA_BINARY" "$MODE_FLAG" collect "$INPUT"
"$KRYMPA_BINARY" "$MODE_FLAG" shorten "$INPUT"
"$KRYMPA_BINARY" "$MODE_FLAG" minimize "$INPUT"
