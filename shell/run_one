#!/usr/bin/env bash
set -e

MODE_FLAG="${KRYMPA_EXECUTION_MODE:---parallel}"
TERM_FLAGS=()
while [ $# -ge 1 ]; do
  case "$1" in
    --term-size)
      TERM_FLAGS=(--term-size)
      shift
      ;;
    --parallel|--sequential)
      MODE_FLAG="$1"
      shift
      ;;
    --execution-mode)
      if [ $# -lt 2 ]; then
        echo "Usage: $0 [--parallel|--sequential] [--term-size] <input-file> [krympa-binary]"
        exit 1
      fi
      MODE_FLAG="--$2"
      shift 2
      ;;
    --execution-mode=parallel)
      MODE_FLAG="--parallel"
      shift
      ;;
    --execution-mode=sequential)
      MODE_FLAG="--sequential"
      shift
      ;;
    *) break ;;
  esac
done

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
  echo "Usage: $0 [--parallel|--sequential] [--term-size] <input-file> [krympa-binary]"
  exit 1
fi

INPUT="$1"
KRYMPA_BINARY="${2:-./krympa}"

cd ../rust || {
  echo "Error: could not cd into ../rust"
  exit 1
}

if [ ! -x "$KRYMPA_BINARY" ]; then
  echo "Error: binary '$KRYMPA_BINARY' not found or not executable."
  exit 1
fi

"$KRYMPA_BINARY" "$MODE_FLAG" "${TERM_FLAGS[@]}" run_vampire "$INPUT"
"$KRYMPA_BINARY" "$MODE_FLAG" "${TERM_FLAGS[@]}" collect "$INPUT"
"$KRYMPA_BINARY" "$MODE_FLAG" "${TERM_FLAGS[@]}" shorten "$INPUT"
"$KRYMPA_BINARY" "$MODE_FLAG" "${TERM_FLAGS[@]}" minimize "$INPUT"
